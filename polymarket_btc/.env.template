# ═══════════════════════════════════════════════════════════════
# POLYMARKET BTC 5-MIN PREDICTION BOT — Konfiguration
# ═══════════════════════════════════════════════════════════════
# Kopiere als ".env" in den gleichen Ordner. NIEMALS committen!

# ── Polymarket Credentials ────────────────────────────────────
POLYMARKET_PRIVATE_KEY=0xDEIN_PRIVATE_KEY_HIER
POLYMARKET_FUNDER=0xDEINE_WALLET_ADRESSE_HIER

# Signature Type: 0=EOA/MetaMask, 1=Email/Magic, 2=Browser
POLYMARKET_SIGNATURE_TYPE=1

# ── Polymarket API (optional, wird automatisch abgeleitet) ───
# Falls du diese manuell setzen willst:
# POLYMARKET_API_KEY=
# POLYMARKET_API_SECRET=
# POLYMARKET_API_PASSPHRASE=

# ── Binance (kein API Key nötig — öffentliche Klines) ────────
# Nur setzen falls du einen eigenen Binance-Proxy nutzt:
# BINANCE_BASE_URL=https://api.binance.com

# ── Strategie-Parameter ──────────────────────────────────────
# M1-Threshold: Mindest-Move in % nach Minute 1
# 0.03 = aggressiv (mehr Trades, ~71% Acc)
# 0.05 = balanced  (Sweet Spot, ~75% Acc)  ← EMPFOHLEN
# 0.10 = konservativ (weniger Trades, ~80% Acc)
M1_THRESHOLD=0.05

# Bet-Size in USDC pro Trade (Basis, bei < $200 Balance)
BET_SIZE=5

# Maximale Trades pro 5-Min-Block (1 = normal)
MAX_TRADES_PER_BLOCK=1

# ── Risk Management ──────────────────────────────────────────
# Maximales Tagesverlust-Limit in USDC (Bot stoppt danach)
DAILY_LOSS_LIMIT=50

# Maximale aufeinanderfolgende Verluste bevor Pause
MAX_LOSS_STREAK=5

# Pause nach Loss-Streak in Sekunden (300 = 5 Min)
STREAK_PAUSE=300

# Maximales Gesamtkapital das der Bot verwenden darf
MAX_BANKROLL=200

# ── Balance-basiertes Position Sizing ───────────────────────
# Startkapital (wird mit Gesamt-P&L addiert → aktuelle Balance)
# Auf dein tatsächliches Startkapital setzen!
INITIAL_BANKROLL=100

# Ab $200 Balance → $7 pro Trade
SCALE_AT_200=200
BET_SIZE_200=7

# Ab $300 Balance → $10 pro Trade
SCALE_AT_300=300
BET_SIZE_300=10

# ── Betriebsmodus ────────────────────────────────────────────
# true = Nur simulieren (Paper Trading)
# false = Echte Orders ⚠️
DRY_RUN=true

# Log-Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ── Telegram Alerts (optional) ───────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Erweiterte Optionen ──────────────────────────────────────
# Maximale Slippage als Dezimal (0.03 = 3 Cent auf $1)
MAX_SLIPPAGE=0.03

# Polymarket CLOB Host (nicht ändern)
CLOB_HOST=https://clob.polymarket.com

# Chain ID (137 = Polygon Mainnet)
CHAIN_ID=137
